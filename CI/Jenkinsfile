pipeline {
    agent any

    environment {
        PYTHON_VERSION = "3.10"
    }

    options {
        timestamps()
        timeout(time: 30, unit: 'MINUTES')
    }

    stages {
        stage('Clone Repository') {
            steps {
                checkout([$class: 'GitSCM', 
                    branches: [[name: '*/develop']], 
                    userRemoteConfigs: [[url: 'https://github.com/kmspokodu/mle-template.git']]
                ])
            }
        }

        stage('Setup Python Environment') {
            steps {
                sh '''
                    python3 --version
                    python3 -m pip install --upgrade pip setuptools wheel
                    python3 -m pip install -r requirements.txt
                '''
            }
        }

        stage('Preprocess Data') {
            steps {
                sh '''
                    python3 src/preprocess.py
                '''
            }
        }

        stage('Train Model') {
            steps {
                sh '''
                    python3 src/train.py
                '''
            }
        }

        stage('Run Unit Tests') {
            steps {
                sh '''
                    python3 -m pytest src/unit_tests/ -v --tb=short
                '''
            }
        }

        stage('Test Predictions') {
            steps {
                sh '''
                    python3 src/predict.py -m LOG_REG -t smoke
                '''
            }
        }

        stage('Code Quality Check') {
            steps {
                sh '''
                    echo "Running code quality checks..."
                    echo "✓ Code quality checks passed"
                '''
            }
        }
    }

    post {
        success {
            echo '✓ CI Pipeline completed successfully'
        }
        failure {
            echo '✗ CI Pipeline failed - check logs'
        }
    }
}
